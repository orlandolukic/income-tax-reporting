# Copy to backend/.env (git-ignored) and adjust. Variables already set in the environment win.

# PostgreSQL (required). Everything is stored in the database (GFI data, PB-1 forms and edits,
# users, sessions) and the app never opens the Excel files. Set it up first:
# .venv\Scripts\alembic upgrade head, then .venv\Scripts\python -m app.gfi_import 2025
# and .venv\Scripts\python -m app.pb1_import 2025.
# Required: without it the backend doesn't start.
# DATABASE_URL=postgresql://income_tax:CHANGE_ME@localhost:5432/income_tax_reporting

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO).
# LOG_LEVEL=INFO

# Folder with "<year> GFI *.xlsx" and "<year> PB-1.xls" (default: the project root). Only the
# imports (gfi_import, pb1_import) read it; the app never does.
# GFI_DATA_DIR=

# PB-1 PDF: a TrueType font with č, ć, đ, š, ž (regular and bold). Optional: by default Arial
# (Windows) or DejaVu / Liberation (Linux) is used.
# PDF_FONT=C:/Windows/Fonts/arial.ttf
# PDF_FONT_BOLD=C:/Windows/Fonts/arialbd.ttf
